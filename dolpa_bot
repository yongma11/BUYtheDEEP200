def fmt_money(v):
    return f"${v:,.2f}" if v is not None else "—"


def msg_header(state):
    on = "▶️ 가동중" if state.get("enabled") else "⏸ 정지중"
    pos = "🟠 보유중" if state.get("holding") else "🟢 현금"
    return (f"📈 *돌파공 (SOXL 돌파+ATR필터)*\n"
            f"{on}  ·  {pos}\n"
            f"━━━━━━━━━━━━━━━━━━")


def msg_schedule():
    et = now_et()
    d = et.date()
    o = et_at(d, MARKET_OPEN)
    c = et_at(d, MARKET_CLOSE)
    return (f"🗓 *오늘 스케줄 (KST)*\n"
            f"🔔 필터 브리핑  {kst_str(o - timedelta(minutes=PREOPEN_MIN))}\n"
            f"🌅 시가 확정·주문  {kst_str(o + timedelta(minutes=POSTOPEN_MIN))}\n"
            f"🌙 체결 확인  {kst_str(c + timedelta(minutes=POSTCLOSE_MIN))}")


def msg_preopen(state, v):
    """① 개장 30분 전 — 필터 판정."""
    et = now_et()
    o = et_at(et.date(), MARKET_OPEN)
    lines = [msg_header(state), ""]

    if v is None:
        lines.append("⚠️ 지표 계산 실패 — 데이터 수신을 확인하세요.")
        return "\n".join(lines)

    if v["skip"]:
        lines += [
            "🚨 *오늘은 매매 정지 (필터 발동)*",
            "",
            "전일 기준 두 조건이 동시에 성립했습니다:",
            f"  • ATR30% *{v['atr_pct']:.2f}%* ≥ 1년 70%분위 *{v['p70']:.2f}%*  (고변동)",
            f"  • 전일종가 *{fmt_money(v['close'])}* < MA30 *{fmt_money(v['ma'])}*  (추세이탈)",
            "",
            "→ *신규 매수 없음.* 개장 시각에 깨어 있을 필요 없습니다.",
        ]
    else:
        why = []
        if not v["cond_vol"]:
            why.append(f"변동성 정상 (ATR30% {v['atr_pct']:.2f}% < {v['p70']:.2f}%)")
        if not v["cond_trend"]:
            why.append(f"추세 유지 (종가 {fmt_money(v['close'])} ≥ MA30 {fmt_money(v['ma'])})")
        lines += [
            "⚡ *오늘 매매 대기 (필터 통과)*",
            "",
            "  • " + "\n  • ".join(why),
            "",
            f"개장 *{kst_str(o)} KST* 직후 시가가 확정되면",
            f"트리거가(시가 × {1+BREAKOUT_PCT:.3f})를 계산해 다시 보냅니다.",
        ]

    if state.get("holding"):
        ep = state.get("entry_price")
        lines += ["", "━━━━━━━━━━━━━━━━━━",
                  f"📦 *보유 포지션* — {state.get('shares', 0)}주 @ {fmt_money(ep)}",
                  f"→ 오늘 *개장 시가에 전량 매도* 하세요."]

    lines += ["", msg_schedule()]
    return "\n".join(lines)


def msg_open(state, v, tick):
    """② 개장 +2분 — 시가 확정, 트리거가 안내."""
    lines = [msg_header(state), ""]
    op = tick["open"]
    cur = tick["price"]

    # 매도가 먼저
    if state.get("holding"):
        ep = state.get("entry_price") or 0
        sh = state.get("shares", 0)
        pnl = (op - ep) * sh if ep else 0
        pnl_pct = ((op / ep - 1) * 100) if ep else 0
        lines += [
            "🔴 *[매도] 지금 시가에 전량 청산*",
            f"  • {sh}주 · 시가 *{fmt_money(op)}*",
            f"  • 진입가 {fmt_money(ep)} → 손익 *{pnl:+,.2f}* ({pnl_pct:+.2f}%)",
            "",
        ]

    if v and v["skip"]:
        lines += ["🚨 *신규 매수 없음* — 필터 발동일입니다.", ""]
    else:
        trig = op * (1 + BREAKOUT_PCT)
        budget = state.get("budget", 0.0)
        qty = int(budget / trig) if (budget and trig > 0) else 0
        hit = tick["high"] >= trig
        lines += [
            f"🔵 *[매수] 트리거 {fmt_money(trig)}*",
            f"  • 당일시가 {fmt_money(op)} × {1+BREAKOUT_PCT:.3f}",
            f"  • 현재가 {fmt_money(cur)}"
            + (f"  ⚠️ *이미 트리거 돌파*" if hit else ""),
        ]
        if qty:
            lines.append(f"  • 예산 {fmt_money(budget)} 기준 약 *{qty}주*")
        lines += [
            "",
            ("⚠️ 이미 트리거를 넘겼습니다. 지금 진입하면 백테스트 가정보다\n"
             "   불리한 가격입니다 — 추격 여부는 직접 판단하세요."
             if hit else
             f"→ *{fmt_money(trig)} 이상으로 올라가면* 그 가격 근처에서 매수.\n"
             f"   장중 도달하지 않으면 오늘은 진입 없음."),
        ]

    lines += ["", "━━━━━━━━━━━━━━━━━━",
              "체결하셨으면 아래 버튼으로 알려주세요."]
    return "\n".join(lines)


def msg_postclose(state, tick):
    """③ 마감 후 — 체결 확인 요청."""
    lines = [msg_header(state), "", "🌙 *장 마감 — 체결 확인*", ""]
    if tick:
        lines.append(f"오늘 종가 *{fmt_money(tick['price'])}* "
                     f"(시가 {fmt_money(tick['open'])} / 고가 {fmt_money(tick['high'])})")
        lines.append("")
    if state.get("holding"):
        lines += [f"현재 상태: *보유중* {state.get('shares',0)}주 "
                  f"@ {fmt_money(state.get('entry_price'))}",
                  "",
                  "내일 시가에 청산 예정입니다."]
    else:
        lines += ["현재 상태: *현금*", "",
                  "매수 체결하셨다면 '✅ 매수 체결' 버튼을 눌러주세요."]
    return "\n".join(lines)


def msg_status(state, df=None):
    lines = [msg_header(state), ""]
    v = None
    if df is not None:
        v = filter_verdict(df, session_date=now_et().date())
    if v:
        tag = "🚨 매매정지" if v["skip"] else "⚡ 매매대기"
        lines += [f"오늘 판정: *{tag}*",
                  f"  • ATR30% {v['atr_pct']:.2f}% / 기준 {v['p70']:.2f}%"
                  if v['atr_pct'] else "  • 지표 부족",
                  f"  • 종가 {fmt_money(v['close'])} / MA30 {fmt_money(v['ma'])}",
                  ""]
    lines += [f"💰 예산 {fmt_money(state.get('budget'))}",
              f"📦 보유 {'있음' if state.get('holding') else '없음'}"]
    if state.get("holding"):
        lines.append(f"   {state.get('shares',0)}주 @ {fmt_money(state.get('entry_price'))} "
                     f"({state.get('entry_date')})")
    tr = state.get("trades", [])
    if tr:
        realized = sum(t.get("pnl", 0) or 0 for t in tr if t.get("side") == "SELL")
        lines += ["", f"📊 누적 실현손익 *{realized:+,.2f}* ({len(tr)}건)"]
    lines += ["", msg_schedule()]
    return "\n".join(lines)


def msg_history(state, n=10):
    tr = state.get("trades", [])
    if not tr:
        return "📜 거래 내역이 없습니다."
    lines = ["📜 *최근 거래내역*", ""]
    for t in tr[-n:][::-1]:
        if t["side"] == "BUY":
            lines.append(f"🔵 {t['date']} 매수 {t['shares']}주 @ {fmt_money(t['price'])}")
        else:
            lines.append(f"🔴 {t['date']} 매도 {t['shares']}주 @ {fmt_money(t['price'])} "
                         f"({t.get('pnl', 0):+,.2f})")
    realized = sum(t.get("pnl", 0) or 0 for t in tr if t.get("side") == "SELL")
    lines += ["", f"누적 실현손익 *{realized:+,.2f}*"]
    return "\n".join(lines)


# ============================================================================
#  버튼 핸들러
# ============================================================================
def handle_callback(data, state, df, tick_cache):
    """반환: (응답 텍스트, 키보드 표시 여부)"""
    if data == "status":
        return msg_status(state, df), True

    if data == "position":
        if not state.get("holding"):
            return "📦 보유 포지션이 없습니다. (현금 상태)", True
        ep = state.get("entry_price") or 0
        sh = state.get("shares", 0)
        t = tick_cache.get("tick")
        cur = t["price"] if t else None
        lines = ["📦 *보유 포지션*", "",
                 f"  {sh}주 @ {fmt_money(ep)}",
                 f"  진입일 {state.get('entry_date')}"]
        if cur:
            pnl = (cur - ep) * sh
            lines += [f"  현재가 {fmt_money(cur)}",
                      f"  평가손익 *{pnl:+,.2f}* ({(cur/ep-1)*100:+.2f}%)"]
        lines += ["", "→ 다음 개장 시가에 전량 청산합니다."]
        return "\n".join(lines), True

    if data == "fill_buy":
        if state.get("holding"):
            return "⚠️ 이미 보유 중으로 기록돼 있습니다. 먼저 매도를 기록하세요.", True
        t = tick_cache.get("tick") or fetch_today_open()
        if not t:
            return "⚠️ 시세를 받지 못했습니다. 잠시 후 다시 시도하세요.", True
        trig = t["open"] * (1 + BREAKOUT_PCT)
        budget = state.get("budget", 0.0)
        qty = int(budget / trig) if (budget and trig > 0) else 0
        state["holding"] = True
        state["entry_price"] = round(trig, 2)
        state["entry_date"] = str(t["date"])
        state["shares"] = qty
        state.setdefault("trades", []).append({
            "date": str(t["date"]), "side": "BUY",
            "price": round(trig, 2), "shares": qty, "pnl": None})
        save_state(state)
        return (f"✅ *매수 체결 기록*\n\n"
                f"  {qty}주 @ {fmt_money(trig)}\n"
                f"  ({t['date']})\n\n"
                f"수량·단가가 실제와 다르면 `/set` 으로 정정하세요.\n"
                f"예: `/set shares 34`  ·  `/set price 41.25`"), True

    if data == "fill_sell":
        if not state.get("holding"):
            return "⚠️ 보유 포지션이 없습니다.", True
        t = tick_cache.get("tick") or fetch_today_open()
        px = t["open"] if t else state.get("entry_price")
        ep = state.get("entry_price") or 0
        sh = state.get("shares", 0)
        pnl = (px - ep) * sh
        state.setdefault("trades", []).append({
            "date": str(t["date"]) if t else str(now_et().date()), "side": "SELL",
            "price": round(px, 2), "shares": sh, "pnl": round(pnl, 2)})
        state["holding"] = False
        state["entry_price"] = None
        state["entry_date"] = None
        state["shares"] = 0
        save_state(state)
        return (f"💰 *매도 체결 기록*\n\n"
                f"  {sh}주 @ {fmt_money(px)}\n"
                f"  손익 *{pnl:+,.2f}*\n\n"
                f"현금 상태로 전환했습니다."), True

    if data == "history":
        return msg_history(state), True

    if data == "toggle":
        state["enabled"] = not state.get("enabled", True)
        save_state(state)
        return ("▶️ 봇을 *가동*했습니다. 정규 알림을 다시 보냅니다."
                if state["enabled"] else
                "⏸ 봇을 *정지*했습니다. 정규 알림을 보내지 않습니다.\n"
                "(버튼 조회는 계속 됩니다)"), True

    return "알 수 없는 명령입니다.", True


def handle_command(text, state, df, tick_cache):
    t = text.strip()
    low = t.lower()

    if low in ("/start", "/menu", "메뉴"):
        return msg_status(state, df), True
    if low == "/status" or low == "상태":
        return msg_status(state, df), True
    if low == "/history":
        return msg_history(state), True
    if low.startswith("/budget"):
        parts = t.split()
        if len(parts) >= 2:
            try:
                state["budget"] = float(parts[1].replace(",", "").replace("$", ""))
                save_state(state)
                return f"💰 예산을 *{fmt_money(state['budget'])}* 로 설정했습니다.", True
            except ValueError:
                pass
        return f"현재 예산: *{fmt_money(state.get('budget'))}*\n사용법: `/budget 5000`", True
    if low.startswith("/set"):
        parts = t.split()
        if len(parts) >= 3:
            k, val = parts[1].lower(), parts[2]
            try:
                if k == "shares":
                    state["shares"] = int(val)
                elif k == "price":
                    state["entry_price"] = float(val)
                else:
                    return "설정 가능: `shares`, `price`", True
                save_state(state)
                return (f"✏️ 수정 완료 — {state.get('shares',0)}주 @ "
                        f"{fmt_money(state.get('entry_price'))}"), True
            except ValueError:
                return "숫자 형식이 올바르지 않습니다.", True
        return "사용법: `/set shares 34` 또는 `/set price 41.25`", True
    if low == "/help":
        return ("💡 *명령어*\n\n"
                "`/status` 현재 상태·오늘 판정\n"
                "`/budget 5000` 운용 예산 설정\n"
                "`/set shares 34` 보유 수량 정정\n"
                "`/set price 41.25` 진입가 정정\n"
                "`/history` 거래 내역\n\n"
                "체결 기록은 아래 버튼을 쓰세요."), True

    return None, False


# ============================================================================
#  정규 발송
# ============================================================================
def run_scheduled(state, force_slot=None):
    """시각을 보고 해당하는 알림을 발송. force_slot으로 강제 실행 가능."""
    et = now_et()
    d = et.date()
    if not is_weekday(d) and not force_slot:
        return

    o = et_at(d, MARKET_OPEN)
    c = et_at(d, MARKET_CLOSE)
    pre = o - timedelta(minutes=PREOPEN_MIN)
    post = o + timedelta(minutes=POSTOPEN_MIN)
    after = c + timedelta(minutes=POSTCLOSE_MIN)

    def within(target, window_min=8):
        return target <= et < target + timedelta(minutes=window_min)

    slot = force_slot
    if slot is None:
        if within(pre):
            slot = "preopen"
        elif within(post):
            slot = "open"
        elif within(after):
            slot = "postclose"
    if slot is None:
        return
    if already_sent(state, slot) and not force_slot:
        return
    if not state.get("enabled") and not force_slot:
        return

    df = fetch_daily()
    if df is None:
        tg_send("⚠️ *돌파공* — 시세 수신 실패\n일봉 데이터를 받지 못했습니다. "
                "잠시 후 자동 재시도합니다.")
        return
    v = filter_verdict(df, session_date=d)

    if slot == "preopen":
        tg_send(msg_preopen(state, v), MENU_KEYBOARD)
        mark_sent(state, slot)

    elif slot == "open":
        # 스킵일이고 보유도 없으면 보낼 내용이 없다
        if v and v["skip"] and not state.get("holding"):
            mark_sent(state, slot)
            return
        tick = fetch_today_open()
        if not tick:
            tg_send("⚠️ *돌파공* — 당일 시가를 받지 못했습니다.\n"
                    "직접 확인 후 수동 판단하세요.", MENU_KEYBOARD)
            return
        tg_send(msg_open(state, v, tick), MENU_KEYBOARD)
        mark_sent(state, slot)

    elif slot == "postclose":
        tick = fetch_today_open()
        tg_send(msg_postclose(state, tick), MENU_KEYBOARD)
        mark_sent(state, slot)


# ============================================================================
#  메인 루프 (스케줄 + 버튼 폴링 동시)
# ============================================================================
def main_loop():
    state = load_state()
    tick_cache = {"tick": None, "at": None}
    df_cache = {"df": None, "at": None}
    offset = None

    print("📈 돌파공 봇 시작 — 스케줄 + 버튼 폴링")
    tg_send(msg_header(state) + "\n\n봇을 시작했습니다.", MENU_KEYBOARD)

    while True:
        try:
            state = load_state()

            # 1) 정규 스케줄 확인
            run_scheduled(state)

            # 2) 캐시 갱신 (일봉 6시간 / 틱 3분)
            now = time.time()
            if df_cache["at"] is None or now - df_cache["at"] > 21600:
                d = fetch_daily()
                if d is not None:
                    df_cache["df"] = d
                    df_cache["at"] = now
            if tick_cache["at"] is None or now - tick_cache["at"] > 180:
                t = fetch_today_open()
                if t:
                    tick_cache["tick"] = t
                    tick_cache["at"] = now

            # 3) 버튼·명령 폴링
            for upd in tg_get_updates(offset, timeout=20):
                offset = upd["update_id"] + 1
                state = load_state()

                if "callback_query" in upd:
                    cb = upd["callback_query"]
                    text, kb = handle_callback(cb.get("data", ""), state,
                                                df_cache["df"], tick_cache)
                    tg_answer_callback(cb["id"])
                    tg_send(text, MENU_KEYBOARD if kb else None,
                            chat_id=cb["message"]["chat"]["id"])

                elif "message" in upd and "text" in upd["message"]:
                    m = upd["message"]
                    text, kb = handle_command(m["text"], state,
                                               df_cache["df"], tick_cache)
                    if text:
                        tg_send(text, MENU_KEYBOARD if kb else None,
                                chat_id=m["chat"]["id"])

        except KeyboardInterrupt:
            print("종료합니다.")
            break
        except Exception as e:
            print(f"🚨 루프 오류: {e}")
            traceback.print_exc()
            time.sleep(30)


if __name__ == "__main__":
    args = sys.argv[1:]
    if "--test" in args:
        s = load_state()
        slot = "preopen"
        for a in args:
            if a in ("preopen", "open", "postclose"):
                slot = a
        print(f"테스트 발송: {slot}")
        run_scheduled(s, force_slot=slot)
    elif "--once" in args:
        s = load_state()
        run_scheduled(s)
    else:
        main_loop()
