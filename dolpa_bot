#   매년 재최적화가 고정 대비 우위 없음 → 고정 사용 권장.
BREAKOUT_PCT = 0.015     # 트리거 = 당일시가 × (1 + 이 값)
ATR_WINDOW   = 30
PCTL_WINDOW  = 252
PCTL_Q       = 0.70
MA_WINDOW    = 30

