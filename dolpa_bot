def tg_send(text, keyboard=None, chat_id=None):
    if not TELEGRAM_TOKEN or not (chat_id or TELEGRAM_CHAT_ID):
        print("⚠️ BOT_TOKEN/CHAT_ID 미설정 — 콘솔 출력으로 대체\n" + text)
        return None
    url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
    payload = {"chat_id": chat_id or TELEGRAM_CHAT_ID, "text": text,
               "parse_mode": "Markdown"}
    if keyboard:
        payload["reply_markup"] = json.dumps(keyboard)
    try:
        r = requests.post(url, json=payload, timeout=15)
        r.raise_for_status()
        return r.json()
    except Exception as e:
        print(f"🚨 텔레그램 전송 실패: {e}")
        return None


def tg_answer_callback(cb_id, text=""):
    if not TELEGRAM_TOKEN:
        return
    try:
        requests.post(
            f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/answerCallbackQuery",
            json={"callback_query_id": cb_id, "text": text}, timeout=10)
    except Exception:
        pass


def tg_get_updates(offset=None, timeout=25):
    if not TELEGRAM_TOKEN:
        return []
    try:
        params = {"timeout": timeout}
        if offset is not None:
            params["offset"] = offset
        r = requests.get(f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/getUpdates",
                         params=params, timeout=timeout + 10)
        r.raise_for_status()
        return r.json().get("result", [])
    except Exception:
        return []


