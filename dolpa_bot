#  시간 유틸
# ============================================================================
def now_et():
    if _HAS_ZI:
        return datetime.now(ZoneInfo("America/New_York"))
    k = datetime.utcnow() + timedelta(hours=9)
    dst = (3 < k.month < 11) or (k.month == 3 and k.day >= 8) or (k.month == 11 and k.day < 7)
    return k - timedelta(hours=13 if dst else 14)


def now_kst():
    if _HAS_ZI:
        return datetime.now(ZoneInfo("Asia/Seoul"))
    return datetime.utcnow() + timedelta(hours=9)


def et_at(d, hm):
    """해당 ET 날짜의 특정 시각(hh, mm)을 tz-aware datetime으로."""
    base = datetime(d.year, d.month, d.day, hm[0], hm[1])
    if _HAS_ZI:
        return base.replace(tzinfo=ZoneInfo("America/New_York"))
    return base


def is_weekday(d):
    return d.weekday() < 5


def kst_str(dt_et):
    """ET datetime을 KST 문자열로."""
    if _HAS_ZI:
        return dt_et.astimezone(ZoneInfo("Asia/Seoul")).strftime("%H:%M")
    return (dt_et + timedelta(hours=14)).strftime("%H:%M")


# ============================================================================
#  상태 저장 (로컬 JSON — 필요하면 GitHub 연동으로 교체 가능)
# ============================================================================
def load_state():
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            s = json.load(f)
        out = dict(DEFAULT_STATE)
        out.update(s)
        return out
    except Exception:
        return dict(DEFAULT_STATE)


def save_state(s):
    try:
        with open(STATE_FILE, "w", encoding="utf-8") as f:
            json.dump(s, f, ensure_ascii=False, indent=2)
        return True
    except Exception as e:
        print(f"상태 저장 실패: {e}")
        return False


def mark_sent(s, slot):
    key = f"{now_et().date()}:{slot}"
    s.setdefault("sent", {})[key] = True
    # 오래된 기록 정리 (30일치만)
    cutoff = str(now_et().date() - timedelta(days=30))
    s["sent"] = {k: v for k, v in s["sent"].items() if k.split(":")[0] >= cutoff}
    save_state(s)


def already_sent(s, slot):
    return s.get("sent", {}).get(f"{now_et().date()}:{slot}", False)


