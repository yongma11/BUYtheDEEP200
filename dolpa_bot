def fetch_daily():
    """일봉 OHLC. Yahoo 차트 API 직접 호출 (yfinance 의존 없음).
    ⚠️ 지표 계산용이므로 '전일까지' 데이터만 쓴다. 당일 봉이 섞여 들어와도
       filter_verdict()에서 전일 인덱스를 명시적으로 잡아 사용한다."""
    for attempt in range(3):
        try:
            url = (f"https://query1.finance.yahoo.com/v8/finance/chart/{TICKER}"
                   f"?range=3y&interval=1d")
            r = requests.get(url, headers={"User-Agent": "Mozilla/5.0"}, timeout=15)
            r.raise_for_status()
            res = r.json()["chart"]["result"][0]
            ts = res["timestamp"]
            q = res["indicators"]["quote"][0]
            df = pd.DataFrame({
                "Open": q["open"], "High": q["high"],
                "Low": q["low"], "Close": q["close"],
            }, index=pd.to_datetime(ts, unit="s"))
            df.index = pd.DatetimeIndex(df.index).tz_localize(None).normalize()
            df = df.dropna()
            if len(df) > 300:
                return df
        except Exception as e:
            print(f"일봉 수신 실패({attempt+1}/3): {e}")
            time.sleep(2)
    return None


def fetch_today_open():
    """당일 시가. 1분봉 첫 봉의 Open을 쓴다.
    시가는 09:30:00에 확정되고 이후 변하지 않으므로, 개장 직후 언제 불러도 동일하다.
    반환: (세션날짜, 시가, 현재가) 또는 None"""
    for attempt in range(3):
        try:
            url = (f"https://query1.finance.yahoo.com/v8/finance/chart/{TICKER}"
                   f"?range=1d&interval=1m")
            r = requests.get(url, headers={"User-Agent": "Mozilla/5.0"}, timeout=15)
            r.raise_for_status()
            res = r.json()["chart"]["result"][0]
            meta = res.get("meta", {})
            ts = res["timestamp"]
            q = res["indicators"]["quote"][0]
            opens = [x for x in q["open"] if x is not None]
            if not opens:
                raise ValueError("빈 1분봉")
            first_open = float(opens[0])
            last_price = float(meta.get("regularMarketPrice") or opens[-1])
            sess_date = pd.to_datetime(ts[0], unit="s").date()
            # 장중 고가 (트리거 도달 여부 확인용)
            highs = [x for x in q["high"] if x is not None]
            day_high = float(max(highs)) if highs else last_price
            return {"date": sess_date, "open": first_open,
                    "price": last_price, "high": day_high}
        except Exception as e:
            print(f"시가 수신 실패({attempt+1}/3): {e}")
            time.sleep(2)
    return None


# ============================================================================
#  필터 판정 — 전일 데이터만으로 확정된다 (시가와 무관)
# ============================================================================
def compute_indicators(df):
    d = df.copy()
    prev_close = d["Close"].shift(1)
    tr = pd.concat([
        d["High"] - d["Low"],
        (d["High"] - prev_close).abs(),
        (d["Low"] - prev_close).abs(),
    ], axis=1).max(axis=1)
    d["ATR"] = tr.rolling(ATR_WINDOW).mean()
    d["ATR_pct"] = d["ATR"] / d["Close"] * 100.0
    d["ATR_p70"] = d["ATR_pct"].shift(1).rolling(PCTL_WINDOW).quantile(PCTL_Q)
    d["MA"] = d["Close"].rolling(MA_WINDOW).mean()
    return d


def filter_verdict(df, session_date=None):
    """오늘 매수를 스킵해야 하는지 판정.
    session_date: 판정 대상 세션(오늘). 지정하면 그 이전 마지막 봉을 '전일'로 쓴다.
    반환 dict: skip(bool), atr_pct, p70, close, ma, 사유"""
    d = compute_indicators(df)
    if session_date is not None:
        d = d[d.index.date < session_date]
    if len(d) < 2:
        return None
    row = d.iloc[-1]          # 전일 봉
    prev_date = d.index[-1].date()

    atr_pct = row["ATR_pct"]
    p70 = row["ATR_p70"]
    close = row["Close"]
    ma = row["MA"]
    if pd.isna(atr_pct) or pd.isna(p70) or pd.isna(ma):
        return {"skip": True, "prev_date": prev_date, "reason": "지표 워밍업 부족",
                "atr_pct": None, "p70": None, "close": close, "ma": None,
                "cond_vol": None, "cond_trend": None}

    cond_vol = bool(atr_pct >= p70)      # 변동성이 최근 1년 상위 30%
    cond_trend = bool(close < ma)        # 추세가 MA30 아래
    skip = cond_vol and cond_trend

    return {"skip": skip, "prev_date": prev_date,
            "atr_pct": float(atr_pct), "p70": float(p70),
            "close": float(close), "ma": float(ma),
            "cond_vol": cond_vol, "cond_trend": cond_trend,
            "reason": ("고변동 + 추세이탈" if skip else "정상")}


